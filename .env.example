# Supabase project URL — found in Project Settings → API
VITE_SUPABASE_URL=

# Supabase anon (public) key — safe to expose in the browser
VITE_SUPABASE_ANON_KEY=

# Resend API key — for sending reminder emails via Edge Functions
RESEND_API_KEY=

# Sender address for reminder emails (must be a verified Resend domain)
EMAIL_FROM=

# Supabase service role key — used by admin scripts (import-staff.mjs etc.)
# NEVER expose this in the browser. Keep it in .env only (already gitignored).
# Found in Supabase dashboard → Project Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY=
